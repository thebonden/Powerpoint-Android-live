<?xml version="1.0" encoding="utf-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="OnLoad">
  <ribbon><tabs><tab id="AndroidLiveTab" label="Android Live">
    <group id="AndroidLiveControls" label="Android overlay · 0.0.002">
      <button id="AddMarker" label="Add overlay marker" imageMso="ShapeRectangle" size="large" onAction="OnAddMarker" getEnabled="GetEnabled" supertip="Adds or selects the marker on this slide. Move and resize it in Normal view." />
      <button id="StartAndroid" label="Start Android" imageMso="Play" size="large" onAction="OnStart" getEnabled="GetEnabled" />
      <button id="StopAndroid" label="Stop Android" imageMso="Stop" onAction="OnStop" getEnabled="GetEnabled" />
      <toggleButton id="ShowOverlay" label="Show overlay" onAction="OnToggle" getPressed="GetPressed" getEnabled="GetEnabled" />
      <button id="Settings" label="Settings" imageMso="PropertySheet" onAction="OnSettings" getEnabled="GetEnabled" />
      <button id="Status" label="Status / diagnostics" imageMso="Info" onAction="OnStatus" getEnabled="GetEnabled" />
    </group>
    <group id="OverlayNotice" label="Development build"><labelControl id="NotEmbedded" label="External window · not embedded video" /></group>
  </tab></tabs></ribbon>
</customUI>
